{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Lab Finding",
  "description": "Shape and consistency contract. Validation does not establish the truth of a claim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "claim", "scope", "verdict", "priority", "status", "confidence", "evidence", "proof", "reproduction", "trace", "limitations", "next_experiment"],
  "properties": {
    "id": {"type": "string", "pattern": "^LAB-F[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "statement"],
      "properties": {
        "type": {"enum": ["recommendation", "hypothesis", "observation", "causal_claim", "formal_claim"]},
        "statement": {"type": "string", "minLength": 1}
      }
    },
    "scope": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["WOW", "MEH"]},
    "priority": {"type": "integer", "minimum": 0},
    "status": {"enum": ["idea", "source_supported", "externally_reported", "locally_tested", "independently_reproduced", "production_confirmed", "rejected", "superseded"]},
    "confidence": {
      "type": "object", "additionalProperties": false,
      "required": ["mechanism", "lab_benefit", "calibrated_probability", "calibration_ref"],
      "properties": {
        "mechanism": {"$ref": "#/$defs/confidenceAssessment"},
        "lab_benefit": {"$ref": "#/$defs/confidenceAssessment"},
        "calibrated_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "calibration_ref": {"type": ["string", "null"], "minLength": 1}
      },
      "if": {"properties": {"calibrated_probability": {"type": "number"}}},
      "then": {"properties": {"calibration_ref": {"type": "string", "minLength": 1}}}
    },
    "evidence": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["evidence_id", "source_id", "locator", "relation", "basis", "supports", "does_not_establish"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "source_id": {"type": "string", "pattern": "^SRC-[0-9]{3}$"},
          "locator": {"type": "string", "minLength": 1},
          "relation": {"enum": ["supports", "contradicts", "qualifies", "background"]},
          "basis": {"enum": ["primary_documentation", "author_reported_experiment", "source_inspection", "local_measurement", "independent_replication", "formal_verification"]},
          "supports": {"type": "string", "minLength": 1},
          "does_not_establish": {"type": "string", "minLength": 1}
        }
      }
    },
    "proof": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "status", "evidence_ids", "conditions", "note"],
      "properties": {
        "kind": {"enum": ["none", "empirical", "formal"]},
        "status": {"enum": ["not_run", "externally_reported", "locally_observed", "independently_reproduced", "production_confirmed", "formally_verified", "failed", "inconclusive"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "not_run"}}}, "then": {"properties": {"kind": {"const": "none"}, "evidence_ids": {"maxItems": 0}}}},
        {"if": {"properties": {"status": {"const": "formally_verified"}}}, "then": {"properties": {"kind": {"const": "formal"}, "evidence_ids": {"minItems": 1}}}},
        {"if": {"properties": {"status": {"enum": ["locally_observed", "independently_reproduced", "production_confirmed"]}}}, "then": {"properties": {"kind": {"const": "empirical"}, "evidence_ids": {"minItems": 1}}}}
      ]
    },
    "reproduction": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "command", "environment", "artifact_paths", "measurements"],
      "properties": {
        "status": {"enum": ["not_run", "passed", "failed", "inconclusive"]},
        "command": {"type": ["string", "null"]},
        "environment": {"type": ["string", "null"]},
        "artifact_paths": {"type": "array", "items": {"type": "string"}},
        "measurements": {"type": "array", "items": {"type": "object"}}
      }
    },
    "trace": {
      "type": "object", "additionalProperties": false,
      "required": ["research_event_ids", "execution_trace_id", "execution_span_ids", "attempt_ids", "agent_version", "policy_version", "evaluator_version", "source_ids", "artifact_paths"],
      "properties": {
        "research_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "execution_trace_id": {"type": ["string", "null"]},
        "execution_span_ids": {"type": "array", "items": {"type": "string"}},
        "attempt_ids": {"type": "array", "items": {"type": "string"}},
        "agent_version": {"type": ["string", "null"]},
        "policy_version": {"type": ["string", "null"]},
        "evaluator_version": {"type": ["string", "null"]},
        "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "artifact_paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "next_experiment": {
      "type": "object", "additionalProperties": false,
      "required": ["hypothesis", "comparison", "success_criteria", "budget", "stop_condition"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "comparison": {"type": "string", "minLength": 1},
        "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "budget": {"type": "string", "minLength": 1},
        "stop_condition": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "confidenceAssessment": {
      "type": "object", "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"enum": ["low", "medium", "high"]},
        "basis": {"type": "string", "minLength": 1}
      }
    }
  }
}
